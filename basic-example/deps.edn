{:paths ["src"]

 ;; No deps — app.core uses clojure.string and nothing else. The nREPL server dep,
 ;; the :nrepl/middleware entry and the nREPL-driven test that used to sit here
 ;; were copied from nrepl-example, which is where that app actually lives; see it
 ;; for the live-state-over-nREPL example.
 :deps {}

 :aliases {:test {:extra-paths ["test"]
                  :main-opts ["-m" "app.core-test"]}}

 :tasks {run  {:doc "run the app: prints a greeting and exits"
               :main-opts ["-m" "app.core"]}
         test "jolt -M:test"}

 :jolt/build {:opt true
              :direct-link true
              :tree-shake true}}
